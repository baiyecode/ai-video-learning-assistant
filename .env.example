# Copy to `.env` (root, for docker compose) and/or `backend/.env` (for local `uv run`).
# Never commit the real file.

# --- Application ---
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
# Generate a long random value for production.
APP_SECRET_KEY=change-me-in-production

# --- SQLite / files ---
# Local default; docker compose overrides this to /data/app.db.
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
APP_DATA_DIR=./data
# Optional separate media mount; defaults to $APP_DATA_DIR/media.
# APP_MEDIA_ROOT=./data/media

# --- Observability (ticket #13) ---
# Leave empty to disable Sentry. The SDK reads these names directly (no APP_ prefix).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Backups (docker compose "backup" service / scripts/backup.py) ---
# Local default; the compose backup service overrides this to /backups.
BACKUP_DIR=./data/backups
BACKUP_RETENTION=7

# JSON list of allowed browser origins (CORS). Empty list disables the middleware.
APP_CORS_ORIGINS=["http://localhost:5173"]

# --- Auth / Session (ticket #7) ---
# Optional dedicated HMAC key for access tokens; falls back to APP_SECRET_KEY.
APP_JWT_SECRET=change-me-in-production
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=7
APP_REFRESH_COOKIE_NAME=refresh_token
# Leave unset: Secure cookie in production, relaxed locally. Set true behind HTTPS.
# APP_AUTH_COOKIE_SECURE=true

# --- DeepSeek (analysis, ticket #8) ---
APP_DEEPSEEK_API_KEY=
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_DEEPSEEK_MODEL=deepseek-chat
APP_DAILY_BUDGET_USD=10

# --- docker compose only ---
WEB_PORT=8080
