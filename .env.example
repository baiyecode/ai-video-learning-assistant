# Copy to `.env` (root, for docker compose) and/or `backend/.env` (for local `uv run`).
# Never commit the real file.

# --- Application ---
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
# Generate a long random value for production.
APP_SECRET_KEY=change-me-in-production

# --- SQLite / files ---
# Local default; docker compose overrides this to /data/app.db.
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
APP_DATA_DIR=./data
# Optional separate media mount; defaults to $APP_DATA_DIR/media.
# APP_MEDIA_ROOT=./data/media

# --- Observability (ticket #13) ---
# Leave empty to disable Sentry. The SDK reads these names directly (no APP_ prefix).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Frontend DSN (Vite build arg). Leave empty to disable browser error reporting.
VITE_SENTRY_DSN=

# --- Backups (docker compose "backup" service / scripts/backup.py) ---
# Local default; the compose backup service overrides this to /backups.
BACKUP_DIR=./data/backups
BACKUP_RETENTION=7

# JSON list of allowed browser origins (CORS). Empty list disables the middleware.
# Local development with the Vite dev server needs the 5173 origin below; the
# docker compose stack is same-origin (nginx proxies /api) and pins this to [].
APP_CORS_ORIGINS=["http://localhost:5173"]

# --- Auth / Session (ticket #7) ---
# Optional dedicated HMAC key for access tokens; falls back to APP_SECRET_KEY.
APP_JWT_SECRET=change-me-in-production
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=7
APP_REFRESH_COOKIE_NAME=refresh_token
# Leave unset: Secure cookie in production, relaxed locally. Set true behind HTTPS.
# APP_AUTH_COOKIE_SECURE=true

# --- DeepSeek (analysis, ticket #8) ---
APP_DEEPSEEK_API_KEY=
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_DEEPSEEK_MODEL=deepseek-chat
# Daily AI spend cap (USD, Asia/Shanghai day). At/over the cap new Analyses are
# rejected with 429 budget_exhausted until midnight Beijing time; viewing existing
# results keeps working.
APP_DAILY_BUDGET_USD=10
# Conservative per-Summarizer-call estimate recorded against the budget
# (a map-reduce run records one call per chunk plus one merge call).
APP_ANALYSIS_COST_PER_CALL_USD=0.01
# Free Analyses per Account per Asia/Shanghai day and the end-to-end generation timeout.
# This is the single re-quota knob: docker-compose passes the SAME value to the frontend
# build as VITE_ANALYSIS_DAILY_QUOTA, so the enforced limit and the marketing/discovery
# copy (pricing page, sitemap, llms.txt) can never drift apart and silently lie.
APP_ANALYSIS_DAILY_QUOTA=3
APP_ANALYSIS_TIMEOUT_SECONDS=120
# Long-Subtitle chunking: per-chunk character budget (splits only at cue boundaries)
# and the total input budget. Beyond the input budget, chunks spread across the
# timeline (beginning/middle/end) are summarised and the result is flagged truncated.
APP_ANALYSIS_CHUNK_CHARS=6000
APP_ANALYSIS_MAX_INPUT_CHARS=120000

# --- Download limits (ticket #6) ---
# Global concurrent Downloads; per-Account and per-visitor-IP caps; visitor creations/hour.
APP_DOWNLOAD_GLOBAL_CONCURRENCY=5
APP_DOWNLOAD_ACCOUNT_CONCURRENCY=2
APP_DOWNLOAD_VISITOR_CONCURRENCY=1
APP_DOWNLOAD_VISITOR_HOURLY_LIMIT=5
# Per-Video boundaries (defaults: 2 hours, 2 GiB).
APP_DOWNLOAD_MAX_DURATION_SECONDS=7200
APP_DOWNLOAD_MAX_FILE_SIZE_BYTES=2147483648
# How often expired files are swept. Set 0 to disable the periodic task.
APP_DOWNLOAD_CLEANUP_INTERVAL_SECONDS=60

# --- Subscription / Stripe (ticket P2-01, enforced by P2-10) ---
# Leave the keys empty in development: checkout then answers 503 with an
# understandable message instead of crashing. Production (APP_ENV=production)
# refuses to start while any of the three is empty; the startup error names the
# missing variable.
APP_STRIPE_API_KEY=
APP_STRIPE_WEBHOOK_SECRET=
APP_STRIPE_PRICE_ID=
# Display-only monthly price in USD shown by the pricing UI. Actual charge is
# 以支付方（Stripe）配置为准. Single repricing knob: docker-compose also passes this SAME
# value to the frontend build as VITE_SUBSCRIPTION_MONTHLY_USD (see the build-args block
# below), so backend and the pricing page / sitemap / llms.txt stay on one source.
APP_SUBSCRIPTION_MONTHLY_USD=4.99

# --- Rate limits (ticket #12) ---
# In-memory sliding windows; exceeding one returns 429 too_many_requests with a
# Retry-After header. Per-IP scopes and the per-Account Analysis throttle:
#   POST /api/videos/resolve   10 / minute / IP
#   POST /api/downloads         3 / minute / IP (ticket #6 hourly+concurrency caps still apply)
#   POST /api/auth/login       10 / 15 minutes / IP
#   POST /api/auth/register     5 / hour / IP
#   POST /api/analyses          1 / N seconds / Account
#   POST /api/reports           5 / hour / IP
#   POST /api/auth/verification/request  N / hour / Account (mail-relay guard)
APP_RATE_LIMIT_RESOLVE_PER_MINUTE=10
APP_RATE_LIMIT_DOWNLOAD_PER_MINUTE=3
APP_RATE_LIMIT_LOGIN_PER_15_MINUTES=10
APP_RATE_LIMIT_REGISTER_PER_HOUR=5
APP_RATE_LIMIT_ANALYSIS_SECONDS=10
APP_RATE_LIMIT_REPORT_PER_HOUR=5
APP_RATE_LIMIT_VERIFICATION_REQUEST_PER_HOUR=3
APP_RATE_LIMIT_VERIFICATION_CONFIRM_PER_HOUR=10

# --- Feature switches (ticket #23) ---
# Douyin parsing ships behind this switch. Off: Douyin 页面地址 are rejected during URL
# validation with 422 platform_not_enabled (「抖音暂未开放」). On: 视频页与短链 are a
# supported Platform. Flip via env to open or roll back without a code change.
APP_DOUYIN_ENABLED=false

# --- Email verification (ticket #21 / P2-05) ---
# Lifetime of the one-time verification token, in hours (keep it short; 24h cap).
APP_EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# Base of the return link delivered in the verification email.
APP_FRONTEND_BASE_URL=http://localhost:5173
# SMTP delivery. With host/from empty the sender fails closed with a 503 message
# ("邮件服务未配置") in development; production refuses to start without APP_SMTP_HOST
# and APP_SMTP_FROM (P2-10). Username/password stay optional for unauthenticated relays.
# Tests and APP_FAKE_ADAPTERS never touch these.
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_USE_TLS=true
APP_SMTP_FROM=

# --- SEO / site origin (P3, docker compose "web" build arg) ---
# Public origin baked into canonical, Open Graph and sitemap.xml at frontend
# build time (passed as VITE_SITE_ORIGIN). Must be a bare origin: absolute
# http(s), no credentials, path, query, hash or trailing slash — the frontend
# build fails with the offending value otherwise.
# Production MUST be the public https origin and MUST match
# APP_FRONTEND_BASE_URL, otherwise canonical URLs and verification-email links
# point at different hosts. Loopback origins (localhost/127.0.0.1) make
# robots.txt emit "Disallow: /" and log a build warning, so a local build can
# never be indexed.
SITE_ORIGIN=http://localhost:8080

# --- Billing build-args mirrors (single source; no separate edit needed) ---
# The frontend pricing page, sitemap, llms.txt and descriptors read their price and
# free-quota from VITE_ build args that docker-compose derives from the SAME APP_ vars
# above: VITE_ANALYSIS_DAILY_QUOTA <- APP_ANALYSIS_DAILY_QUOTA, and
# VITE_SUBSCRIPTION_MONTHLY_USD <- APP_SUBSCRIPTION_MONTHLY_USD. Editing the APP_ value
# reprices backend enforcement and the static marketing together; there is nothing to set
# here unless you deliberately want the site to display a different value than the API.
# VITE_ANALYSIS_DAILY_QUOTA=3
# VITE_SUBSCRIPTION_MONTHLY_USD=4.99

# --- docker compose only ---
WEB_PORT=8080
